# abdopuppet: Git backplane + lighttpd + sshd
# Rocky Linux 9 base; git-daemon listens on 9418, lighttpd on 80, sshd on 22.

FROM rockylinux:9

ENV container=docker \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

RUN dnf -y install \
        epel-release \
    && dnf -y install \
        git \
        git-daemon \
        lighttpd \
        openssh-server \
        openssh-clients \
        python3 \
        python3-pip \
        net-tools \
        iproute \
        procps-ng \
        which \
        hostname \
        ca-certificates \
        tar \
        gzip \
        findutils \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Root password for SSH (skill convention)
RUN echo 'root:topstor' | chpasswd

# Enable password auth and PermitRootLogin for the in-cluster SSH
RUN sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && ssh-keygen -A

# lighttpd minimal config
RUN mkdir -p /var/www/html /var/log/lighttpd /run/lighttpd \
    && chown -R lighttpd:lighttpd /var/log/lighttpd /run/lighttpd
COPY scripts/lighttpd.conf /etc/lighttpd/lighttpd.conf

# Placeholder landing page
RUN echo '<h1>TopStor abdopuppet</h1><p>Git backplane (9418) + Web (80)</p>' \
        > /var/www/html/index.html

# Bare-repo landing
RUN mkdir -p /srv/git

EXPOSE 22 80 9418

CMD ["/usr/local/bin/entrypoint.sh"]
