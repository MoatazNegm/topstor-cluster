# Build artifacts / large binary tarballs (~140 MB total)
# These are produced once and baked into Docker images.
# Repopulate from a clean OS using the recipe in DEVELOPMENT.md
# ("Redeploy from a fresh OS").
*.tar.gz
*.tar
*.tgz

# Stale / versioned Dockerfile snapshots
Dockerfile.zfs.v3

# Docker-in-Docker extracted binary dir (one-time extraction)
docker-binaries/

# Build logs and intermediate outputs
build-*.log
*.log
nohup.out

# ALL git directories (outer + any embedded git checkouts)
.git/
**/.git/
**/.git/**

# Regenerable build artifacts (do NOT push)
# These are recreated by the redeploy script described in DEVELOPMENT.md:
#   - node_modules      -> regenerated by `npm install` in volumes/topstor-dev/
#   - puppet-srv/*.git  -> regenerated by `git clone --bare` from volumes/linux-env/
volumes/topstor-dev/node_modules/
volumes/puppet-srv/
volumes/topstorweb-ui/
volumes/linux-env-proxy/

# Editor / OS scratch
.vscode/
.idea/
.DS_Store
*.swp
*.bak
# Local compose backups (created by manage.sh and similar)
docker-compose.yml.bak.*
docker-compose.yml.*~
# zfs container runtime state (bind-mount source)
volumes/linux-env/TopStordata/
# zfs DinD graph root (host-backed)
volumes/zfs-docker-data/
